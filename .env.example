# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=dedupwire

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18236
BACKEND_PORT=19236
DB_PORT=17736

# ---- 数据库 ----
DB_NAME=dedupwire
DB_USER=dedupwire
DB_PASSWORD=dedupwire_pw_2026

# ---- 安全 ----
JWT_SECRET=dedupwire-jwt-secret-change-me-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true

# ---- 算法 A：正文密度抽取 ----
EXTRACT_SCORE_DIVISOR=45
EXTRACT_MIN_BODY_CHARS=120

# ---- 算法 B：MinHash + LSH ----
DEDUP_SIM_THRESHOLD=0.72
DEDUP_SUSPECT_THRESHOLD=0.55
DEDUP_NUM_PERM=128
DEDUP_BANDS=32
DEDUP_SHINGLE_SIZE=4
DEDUP_RATE_LIMIT_PER_MINUTE=10
